# Local mode is the default. Set APP_MODE=public only on a cloud deployment.
APP_MODE=local

# Server-side AI provider. Never place these values in static/app.js or HTML.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=low
# Optional OpenAI-compatible Responses API endpoint for a region/provider deployment.
# OPENAI_BASE_URL=

# Required for public accounts and monthly request quotas.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: persistent mounted disk path. Public uploads otherwise use the OS temp directory.
WORKSPACE_ROOT=
