# 默认是本地模式；仅在云端部署时设置 APP_MODE=public。
APP_MODE=local

# Optional personal model API settings. The provider must support the OpenAI Responses API.
MODEL_API_KEY=
MODEL_NAME=
MODEL_BASE_URL=
MODEL_REASONING_EFFORT=low

# 云端账号和月度请求额度配置。
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 可选：持久化挂载磁盘路径；否则云端上传文件使用系统临时目录。
WORKSPACE_ROOT=
