# 默认是本地模式；仅在云端部署时设置 APP_MODE=public。
APP_MODE=local

# Local fallback key; cloud deployments read it from the server environment.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_REASONING_EFFORT=low
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 云端账号和月度请求额度配置。
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 可选：持久化挂载磁盘路径；否则云端上传文件使用系统临时目录。
WORKSPACE_ROOT=
